# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Any Postgres 14+ instance. Local Docker example:
#   docker run --name actionos-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/actionos

# Optional pool size (default 10). Keep small on serverless.
# DATABASE_POOL_MAX=5

# TLS to Postgres. Auto-enabled for non-localhost hosts when unset.
# Set explicitly for odd setups: DATABASE_SSL=true|false
# DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Public base URL of the app. On Vercel, leave unset to use VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL. Set explicitly for a custom domain.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Vercel / hosted deploy
# ---------------------------------------------------------------------------
# `next build` succeeds without secrets (auth/db init is lazy). Runtime needs
# at least DATABASE_URL and BETTER_AUTH_SECRET in the Vercel project env
# (Preview + Production). Then run migrations + seed against that database:
#   npm run db:migrate && npm run db:seed


# ---------------------------------------------------------------------------
# LLM (optional)
# ---------------------------------------------------------------------------
# The Action Button and shift briefing work without a key using a deterministic
# keyword classifier. Set one of these to enable the LLM path.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Seeding / demo (optional)
# ---------------------------------------------------------------------------
# Password used for the demo accounts created by `npm run db:seed`.
# Demo data is fictional. Never seed a database that holds real client data.
SEED_DEMO_PASSWORD=DemoPassword123!

# List the seeded credentials on /login. Defaults to on in development,
# off in production. Set to true for a hosted demo.
# SHOW_DEMO_LOGINS=true
